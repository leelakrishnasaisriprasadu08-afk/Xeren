# ==============================================================================
# Xeren Database & Service Environment Configuration (Template)
# Copy this file to .env on your device and fill in your actual credentials.
# ==============================================================================

# PostgreSQL (Supabase) Database URL
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/<dbname>
POSTGRES_URI=postgresql+psycopg2://<user>:<password>@<host>:5432/<dbname>

# Qdrant Cloud Vector Database
QDRANT_URL=https://<your-cluster-id>.<region>.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=<your-qdrant-api-key>

# (Optional) MongoDB URI - fallback to offline virtual store if not set
# MONGODB_URI=mongodb://localhost:27017/xeren_workspace
